<!--
  A mesh-free UR10e for headless demos, derived from MuJoCo Menagerie's
  universal_robots_ur10e/ur10e.xml (BSD-3-Clause, see LICENSE-ur10e): the same
  kinematics, inertials, joints and position actuators, drawn with its collision
  shapes. Physics at 1 kHz.
-->
<mujoco model="ur10e_sim">
  <compiler angle="radian" autolimits="true"/>
  <option integrator="implicitfast" timestep="0.001"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.2 0.2 0.2" specular="0 0 0"/>
    <global offwidth="1280" offheight="720" azimuth="120" elevation="-20"/>
  </visual>

  <default>
    <default class="ur10e">
      <joint axis="0 1 0" range="-6.28319 6.28319" armature="0.1"/>
      <general biastype="affine" ctrlrange="-6.2831 6.2831" gainprm="5000" biasprm="0 -5000 -500"/>
      <geom type="capsule" material="linkgray"/>
      <default class="size4">
        <joint damping="10"/>
        <general forcerange="-330 330"/>
      </default>
      <default class="size3">
        <joint damping="5"/>
        <general forcerange="-150 150"/>
        <default class="size3_limited">
          <joint range="-3.1415 3.1415"/>
          <general ctrlrange="-3.1415 3.1415"/>
        </default>
      </default>
      <default class="size2">
        <joint damping="2"/>
        <general forcerange="-56 56"/>
      </default>
      <default class="eef">
        <geom type="cylinder" material="black"/>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="64" height="384"/>
    <texture type="2d" name="ground" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="ground" texture="ground" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="black" rgba="0.033 0.033 0.033 1"/>
    <material name="jointgray" rgba="0.278 0.278 0.278 1"/>
    <material name="linkgray" rgba="0.82 0.82 0.82 1"/>
    <material name="urblue" rgba="0.49 0.678 0.8 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <light name="spotlight" mode="targetbodycom" target="wrist_2_link" pos="0 -1 2"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="ground"/>
    <camera name="scene_cam" pos="2.2 -1.6 1.6" xyaxes="0.6 0.8 0 -0.35 0.26 0.9"/>
    <!-- Under the wrist camera at the home pose. -->
    <geom name="table" type="box" pos="-0.17 0.75 0.15" size="0.4 0.3 0.15" rgba="0.55 0.4 0.3 1"/>
    <geom name="red" type="box" pos="-0.3 0.68 0.36" size="0.06 0.06 0.06" rgba="0.9 0.1 0.1 1"/>
    <geom name="green" type="sphere" pos="-0.02 0.82 0.36" size="0.06" rgba="0.1 0.8 0.2 1"/>

    <body name="base" quat="0 0 0 -1" childclass="ur10e">
      <inertial mass="4.0" pos="0 0 0" diaginertia="0.0061063308908 0.0061063308908 0.01125"/>
      <geom type="cylinder" size="0.08 0.04" pos="0 0 0.04" material="black"/>
      <body name="shoulder_link" pos="0 0 0.181">
        <inertial pos="0 0 0" mass="7.778" diaginertia="0.0314743 0.0314743 0.0218756"/>
        <joint name="shoulder_pan_joint" class="size4" axis="0 0 1"/>
        <geom size="0.078 0.05" pos="0 0 -0.02" material="urblue"/>
        <body name="upper_arm_link" pos="0 0.176 0" quat="1 0 1 0">
          <inertial pos="0 0 0.3065" mass="12.93" diaginertia="0.423074 0.423074 0.0363656"/>
          <joint name="shoulder_lift_joint" class="size4"/>
          <geom pos="0 -0.05 0" quat="1 1 0 0" size="0.078 0.08" material="urblue"/>
          <geom size="0.06 0.3" pos="0 0 0.3"/>
          <body name="forearm_link" pos="0 -0.137 0.613">
            <inertial pos="0 0 0.2855" mass="3.87" diaginertia="0.11059 0.11059 0.0108844"/>
            <joint name="elbow_joint" class="size3_limited"/>
            <geom pos="0 0.08 0" quat="1 1 0 0" size="0.058 0.065" material="urblue"/>
            <geom size="0.043 0.28" pos="0 0 0.29"/>
            <body name="wrist_1_link" pos="0 0 0.571" quat="1 0 1 0">
              <inertial pos="0 0.135 0" quat="0.5 0.5 -0.5 0.5" mass="1.96"
                diaginertia="0.0055125 0.00510825 0.00510825"/>
              <joint name="wrist_1_joint" class="size2"/>
              <geom pos="0 0.06 0" quat="1 1 0 0" size="0.05 0.07" material="jointgray"/>
              <body name="wrist_2_link" pos="0 0.135 0">
                <inertial pos="0 0 0.12" quat="0.5 0.5 -0.5 0.5" mass="1.96"
                  diaginertia="0.0055125 0.00510825 0.00510825"/>
                <joint name="wrist_2_joint" axis="0 0 1" class="size2"/>
                <geom size="0.046 0.065" pos="0 0 0.05" material="jointgray"/>
                <geom pos="0 0.028 0.12" quat="1 1 0 0" size="0.046 0.043" material="jointgray"/>
                <body name="wrist_3_link" pos="0 0 0.12">
                  <inertial pos="0 0.092 0" quat="0 1 -1 0" mass="0.202"
                    diaginertia="0.000204525 0.000144346 0.000144346"/>
                  <joint name="wrist_3_joint" class="size2"/>
                  <geom class="eef" pos="0 0.097 0" quat="1 1 0 0" size="0.046 0.02"/>
                  <site name="attachment_site" pos="0 0.1 0" quat="-1 1 0 0"/>
                  <!-- Looks along the tool axis (+y of this link). -->
                  <camera name="wrist_cam" pos="0 0.12 0.06" xyaxes="1 0 0 0 0 1" fovy="70"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <general class="size4" name="shoulder_pan" joint="shoulder_pan_joint"/>
    <general class="size4" name="shoulder_lift" joint="shoulder_lift_joint"/>
    <general class="size3_limited" name="elbow" joint="elbow_joint"/>
    <general class="size2" name="wrist_1" joint="wrist_1_joint"/>
    <general class="size2" name="wrist_2" joint="wrist_2_joint"/>
    <general class="size2" name="wrist_3" joint="wrist_3_joint"/>
  </actuator>

  <sensor>
    <force name="wrist_force" site="attachment_site"/>
    <torque name="wrist_torque" site="attachment_site"/>
  </sensor>

  <keyframe>
    <key name="home" qpos="-1.5708 -1.5708 1.5708 -1.5708 -1.5708 0"
      ctrl="-1.5708 -1.5708 1.5708 -1.5708 -1.5708 0"/>
  </keyframe>
</mujoco>
