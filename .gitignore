# Unreal plugin local build outputs (ThirdParty package already gitignored in-tree)
integrations/unreal/RLMesh/Binaries/
integrations/unreal/RLMesh/Intermediate/
integrations/unreal/RLMesh/Saved/

# Unreal primitive gym suite SB3 checkpoints / train logs
# (nested .gitignore under demos/<env>/artifacts/)
integrations/unreal/demos/*/artifacts/*/
integrations/unreal/demos/*/artifacts/*
!integrations/unreal/demos/*/artifacts/.gitignore

# Browser binding (javascript/rlmesh): npm deps, wasm-bindgen output, test bundles
javascript/rlmesh/node_modules/
javascript/rlmesh/pkg/
javascript/rlmesh/.test-dist/

# mise file tasks (re-include paths shadowed by build/ above)
!.mise/tasks/
!.mise/tasks/**

# AI Folders (ignored by default)
.agents/
.codex/
.claude/
.cursor/
vault/

# Proposal / design scratch lives in the workspace cabinet, never in-repo
.research
docs/proposals/
