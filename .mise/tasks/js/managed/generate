#!/usr/bin/env node
//MISE description="Regenerate rlmesh/managed's SDK (javascript/rlmesh/src/managed/gen) with Hey API from the managed platform's OpenAPI contract, keeping only its public paths"
//MISE dir="{{ config_root }}"
//USAGE arg "[source]" help="Contract URL or file (default https://api.rlmesh.dev/openapi.yaml)"

// @hey-api/openapi-ts needs TypeScript 5's compiler API, which the package's TypeScript 7 does
// not have, so it runs from a pinned throwaway install here instead of a devDependency. Its fetch
// client is generated into gen/client and gen/core, so the package has no runtime dependency.
// TODO: move the tools to devDependencies once @hey-api/openapi-ts runs on TypeScript 7.
import { execFileSync } from 'node:child_process';
import { mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { pathToFileURL } from 'node:url';

const TOOLS = ['@hey-api/openapi-ts@0.99.0', 'typescript@5.9.3', 'js-yaml@4.1.0'];
const OUT = 'javascript/rlmesh/src/managed/gen';
const BASE_URL = 'https://api.rlmesh.dev';
const source = process.env.usage_source || `${BASE_URL}/openapi.yaml`;

// The platform's public API: what a tenant needs to run and read evaluations. Admin
// (/v1/platform), clusters and their credentials, billing, members, audit, account, connections,
// integrations, webhooks and the rest stay out; add a path here to expose it.
const KEEP = [
  /^\/v1\/(info|me)$/,
  /^\/v1\/evaluations$/,
  /^\/v1\/evaluations\/\{id\}(\/(cancellations|retries|workloads|episodes|logs|telemetry|telemetry\/buckets|metrics|scores|diagnosis|artifacts|artifact-links|events))?$/,
  /^\/v1\/evaluation-(previews|imports)$/,
  /^\/v1\/evaluation-sweeps(\/\{id\})?$/,
  /^\/v1\/(catalog\/compat|perturbations|checkpoints\/recent)$/,
  /^\/v1\/presets(\/\{id\})?$/,
  /^\/v1\/projects(\/\{id\}(\/default)?)?$/,
  /^\/v1\/registry\/(info|repositories)$/,
  /^\/v1\/(repos|repo-restores|repo-probes)(\/|$)/,
  /^\/v1\/probe-runs(\/|$)/,
];

// Text the generated client must never carry: design-record citations and the platform's
// cluster credential and join token prefixes. Generation fails if the kept surface still has any.
const LEAKS = /ADR-\d|rlm_(c[srp]|jt)_/;

// Drop design-record citations from prose, keeping the sentence: "kept 90 days (ADR-NNNN);" reads
// "kept 90 days;", "(ADR-NNNN: deleted ...)" reads "(deleted ...)", "ADR-NNNN retention class."
// reads "Retention class." and "One ADR-NNNN record" reads "One record".
const uncite = (text) =>
  text
    .replace(/\s*\(ADR-\d+\)/g, '')
    .replace(/\(ADR-\d+:\s*/g, '(')
    .replace(/(^|[.!?]\s+)ADR-\d+\s+(\w)/g, (_, before, first) => before + first.toUpperCase())
    .replace(/\bADR-\d+\s+/g, '');
const strip = (node) => {
  if (Array.isArray(node)) return node.forEach(strip);
  if (!node || typeof node !== 'object') return;
  for (const [key, value] of Object.entries(node)) {
    if ((key === 'description' || key === 'summary') && typeof value === 'string') node[key] = uncite(value);
    else strip(value);
  }
};

const tools = mkdtempSync(join(tmpdir(), 'rlmesh-openapi-'));
try {
  execFileSync('npm', ['install', '--prefix', tools, '--no-save', '--no-audit', '--no-fund', '--loglevel=error', ...TOOLS], { stdio: 'inherit' });
  const yaml = createRequire(join(tools, 'package.json'))('js-yaml');
  const { createClient } = await import(pathToFileURL(join(tools, 'node_modules/@hey-api/openapi-ts/dist/index.mjs')).href);

  const text = /^https?:/.test(source) ? await (await fetch(source)).text() : readFileSync(source, 'utf8');
  const spec = yaml.load(text);
  const version = `${spec.info.title} ${spec.info.version}`;
  spec.servers = [{ url: BASE_URL }]; // the generated default client's base URL
  spec.paths = Object.fromEntries(Object.entries(spec.paths).filter(([path]) => KEEP.some((re) => re.test(path))));

  // Keep only the components the kept paths reach.
  const reached = new Set();
  const visit = (node) => {
    if (Array.isArray(node)) return node.forEach(visit);
    if (!node || typeof node !== 'object') return;
    const ref = node.$ref;
    if (typeof ref === 'string' && ref.startsWith('#/components/') && !reached.has(ref)) {
      reached.add(ref);
      const [, , kind, name] = ref.split('/');
      visit(spec.components[kind]?.[name]);
    }
    Object.values(node).forEach(visit);
  };
  visit(spec.paths);
  // Security schemes are named in `security` requirements, not by $ref.
  const operations = Object.values(spec.paths).flatMap((item) => Object.values(item));
  for (const requirement of [...(spec.security ?? []), ...operations.flatMap((op) => op?.security ?? [])]) {
    for (const name of Object.keys(requirement)) reached.add(`#/components/securitySchemes/${name}`);
  }
  for (const kind of Object.keys(spec.components)) {
    spec.components[kind] = Object.fromEntries(Object.entries(spec.components[kind]).filter(([name]) => reached.has(`#/components/${kind}/${name}`)));
  }
  strip(spec);
  const leak = JSON.stringify(spec).match(new RegExp(`.{0,80}(${LEAKS.source}).{0,80}`));
  if (leak) throw new Error(`the kept surface still mentions ${leak[1]}: …${leak[0]}…`);

  const input = join(tools, 'openapi.json');
  writeFileSync(input, JSON.stringify(spec));
  await createClient({
    input,
    output: { path: OUT, clean: true, importFileExtension: '.js' },
    plugins: ['@hey-api/client-fetch', '@hey-api/typescript', '@hey-api/sdk'],
    logs: { level: 'warn' },
  });

  const note = `// Generated by \`mise run js:managed:generate\` from ${source} (${version}), public paths only. Do not edit: regenerate.\n`;
  const files = readdirSync(OUT, { recursive: true }).filter((f) => f.endsWith('.ts'));
  for (const f of files) writeFileSync(join(OUT, f), note + readFileSync(join(OUT, f), 'utf8'));
  console.log(`${OUT}: ${files.length} files, ${Object.keys(spec.paths).length} paths, ${Object.keys(spec.components.schemas ?? {}).length} schemas`);
} finally {
  rmSync(tools, { recursive: true, force: true });
}
