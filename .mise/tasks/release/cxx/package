#!/usr/bin/env bash
#MISE description="Assemble a C/C++ package (headers + prebuilt libs + CMake/pkg-config metadata) and tar it for the host triple, or for Windows with --target windows"
#MISE dir="{{ config_root }}"
#USAGE flag "--target <target>" help="host (default) or windows: cross-build x86_64-pc-windows-msvc with cargo-xwin (needs clang on PATH)" {
#USAGE   choices "host" "windows"
#USAGE }

# Packaging only, no CI / publish. Assembles prebuilt artifacts (cargo-built
# libraries, hand-authored headers) and the metadata pointing consumers at them;
# CMake is never run as a build system here.
set -euo pipefail

target="${usage_target:-host}"

crate="crates/rlmesh-capi"
inc="$PWD/$crate/include"

# The package dir/tarball keeps the full marketing version. The SONAME, CMake
# compat, and .pc Version all key off the binary ABI generation instead — the
# monotonic RLMESH_ABI_VERSION integer in the header, which (unlike the 0.x
# pre-release semver) can actually express an ABI break.
version="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)"   # 0.1.0-beta.2
abi_gen="$(sed -n 's/^#define RLMESH_ABI_VERSION \([0-9][0-9]*\)$/\1/p' "$inc/rlmesh.h")"  # 1
: "${abi_gen:?could not parse RLMESH_ABI_VERSION from $inc/rlmesh.h}"
if [ "$target" = windows ]; then
  triple=x86_64-pc-windows-msvc
else
  triple="$(rustc -vV | sed -n 's/host: //p')"                          # x86_64-unknown-linux-gnu
fi

name="rlmesh-${version}-${triple}"
out="$PWD/target/capi-pkg"
stage="$out/$name"
echo "==> packaging $name (ABI generation $abi_gen)"

# 1. Release-build the libraries.
#    Host: build the staticlib + cdylib, then relink the cdylib with an explicit
#    versioned SONAME (a Rust cdylib carries none by default). Without it a consumer
#    binary records the build-machine absolute path in DT_NEEDED; with it the binary
#    records librlmesh_capi.so.${abi_gen} and the loader refuses a different ABI
#    generation. Deps cache between the two.
#    Windows: cross-build with cargo-xwin, which fetches the MSVC CRT and Windows
#    SDK (accepting Microsoft's license for them, as maturin does for the wheels).
if [ "$target" = windows ]; then
  rustup target add "$triple"
  XWIN_ACCEPT_LICENSE=1 cargo xwin build -p rlmesh-capi --release --lib --target "$triple"
else
  cargo build -p rlmesh-capi --release --lib
  cargo rustc -p rlmesh-capi --release --lib --crate-type cdylib -- \
    -C link-arg=-Wl,-soname,librlmesh_capi.so.${abi_gen}
fi

# 2. Fresh staging tree.
rm -rf "$stage"
mkdir -p "$stage/include" "$stage/lib/cmake/rlmesh"

# 3. Headers + licenses + the libs (verbatim — include/ is the one header authority).
cp "$inc/rlmesh.h" "$inc/rlmesh.hpp" "$inc/dlpack.LICENSE" "$stage/include/"
cp LICENSE-APACHE LICENSE-MIT          "$stage/"
if [ "$target" = windows ]; then
  # The DLL goes in bin/ and its import library in lib/ under the name MSVC
  # projects link (rustc writes it as rlmesh_capi.dll.lib). The Rust staticlib is
  # left out: it is over 100 MB and pulls in the whole Rust runtime.
  built="target/$triple/release"
  mkdir -p "$stage/bin"
  cp "$built/rlmesh_capi.dll" "$built/rlmesh_capi.pdb" "$stage/bin/"
  cp "$built/rlmesh_capi.dll.lib" "$stage/lib/rlmesh_capi.lib"
else
  # Stage the cdylib under its real SONAME + a librlmesh_capi.so dev symlink: the
  # linker reads the SONAME (records the versioned DT_NEEDED) while find_package and
  # -lrlmesh_capi still resolve through the bare name at link time.
  cp target/release/librlmesh_capi.so    "$stage/lib/librlmesh_capi.so.${abi_gen}"
  ln -sf "librlmesh_capi.so.${abi_gen}"  "$stage/lib/librlmesh_capi.so"
  cp target/release/librlmesh_capi.a     "$stage/lib/"
fi

# 4. pkg-config metadata (non-CMake consumers). ${pcfiledir} keeps it relocatable.
#    Windows consumers use CMake or link the import library directly.
if [ "$target" != windows ]; then
mkdir -p "$stage/lib/pkgconfig"
cat > "$stage/lib/pkgconfig/rlmesh.pc" <<EOF
prefix=\${pcfiledir}/../..
includedir=\${prefix}/include
libdir=\${prefix}/lib

Name: rlmesh
Description: RLMesh C/C++ ABI (prebuilt, drop-in, no Rust toolchain)
Version: $abi_gen
Cflags: -I\${includedir}
Libs: -L\${libdir} -lrlmesh_capi
# Native libs the Rust runtime pulls in; a static (.a) link also needs: -lgcc_s -lutil -lrt -lc
Libs.private: -lpthread -ldl -lm
EOF
fi

# 5. CMake config-version: PACKAGE_VERSION is the ABI generation, so the canonical
#    SameMajorVersion template now genuinely rejects a different ABI generation —
#    find_package(rlmesh N) gates the binary ABI, not the inert 0.x semver.
cat > "$stage/lib/cmake/rlmesh/rlmesh-config-version.cmake" <<'EOF'
set(PACKAGE_VERSION "@ABI@")
if(PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE FALSE)
else()
  if(PACKAGE_VERSION MATCHES "^([0-9]+)\\.")
    set(CVF_VERSION_MAJOR "${CMAKE_MATCH_1}")
  else()
    set(CVF_VERSION_MAJOR "${PACKAGE_VERSION}")
  endif()
  if(PACKAGE_FIND_VERSION_MAJOR STREQUAL CVF_VERSION_MAJOR)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
  else()
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
  endif()
  if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
    set(PACKAGE_VERSION_EXACT TRUE)
  endif()
endif()
EOF
sed -i "s/@ABI@/$abi_gen/" "$stage/lib/cmake/rlmesh/rlmesh-config-version.cmake"

# 6. The CMake config itself is a committed template (static text, nothing to
#    interpolate) — copied verbatim so it stays reviewable as a normal source file.
cp "$crate/packaging/rlmesh-config.cmake" "$stage/lib/cmake/rlmesh/"

# 7. Root CMakeLists.txt, so FetchContent_MakeAvailable / add_subdirectory can
#    consume the tarball by URL. It loads the same config find_package does, then
#    promotes the imported targets it created to GLOBAL: a subdirectory's imported
#    targets are otherwise invisible to the parent project that links them. A
#    target that already existed (the parent's own find_package(rlmesh) or Threads)
#    is already visible, and CMake refuses to promote it outside its directory.
cat > "$stage/CMakeLists.txt" <<'EOF'
cmake_minimum_required(VERSION 3.20)
set(_rlmesh_created "")
foreach(_rlmesh_target IN ITEMS Threads::Threads rlmesh::rlmesh rlmesh::rlmesh_static)
  if(NOT TARGET ${_rlmesh_target})
    list(APPEND _rlmesh_created ${_rlmesh_target})
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/lib/cmake/rlmesh/rlmesh-config.cmake")
foreach(_rlmesh_target IN LISTS _rlmesh_created)
  if(TARGET ${_rlmesh_target})
    set_target_properties(${_rlmesh_target} PROPERTIES IMPORTED_GLOBAL TRUE)
  endif()
endforeach()
EOF

# 8. Terse consume note.
cat > "$stage/README.md" <<EOF
# rlmesh $version ($triple)

Prebuilt RLMesh C/C++ ABI — drop-in, no Rust toolchain required.

## CMake
    find_package(rlmesh CONFIG REQUIRED)
    target_link_libraries(app PRIVATE rlmesh::rlmesh)
Point -Drlmesh_DIR=<this>/lib/cmake/rlmesh, or add <this> to CMAKE_PREFIX_PATH.

Or fetch the release tarball at configure time:
    include(FetchContent)
    FetchContent_Declare(rlmesh URL <tarball URL> URL_HASH SHA256=<its .sha256>)
    FetchContent_MakeAvailable(rlmesh)
    target_link_libraries(app PRIVATE rlmesh::rlmesh)
EOF
if [ "$target" = windows ]; then
cat >> "$stage/README.md" <<'EOF'

## MSVC without CMake
Add <this>/include to the include path, link <this>/lib/rlmesh_capi.lib (the
import library), and ship bin/rlmesh_capi.dll beside your .exe. The headers need
/std:c++17 (C++) and exception handling (/EHsc).

## Notes
- Built with the MSVC toolchain (x86_64-pc-windows-msvc) against the UCRT, which
  ships with Windows 10 and later.
- bin/rlmesh_capi.pdb holds the DLL's debug symbols.
EOF
else
cat >> "$stage/README.md" <<'EOF'

## pkg-config
    export PKG_CONFIG_PATH=<this>/lib/pkgconfig
    pkg-config --cflags --libs rlmesh

## Notes
- Static link: use rlmesh::rlmesh_static (engine targets with no other Rust).
- The .so is found at run time via your rpath / LD_LIBRARY_PATH — stage it beside
  your binary or add <this>/lib.
EOF
fi

# 9. Tar from \$out so the archive's single root is the versioned dir, plus the
#    checksum a FetchContent URL_HASH pins.
tar -C "$out" -czf "$out/$name.tar.gz" "$name"
(cd "$out" && sha256sum "$name.tar.gz" > "$name.tar.gz.sha256")
echo "==> wrote $out/$name.tar.gz"
