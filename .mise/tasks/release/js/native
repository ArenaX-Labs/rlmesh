#!/usr/bin/env bash
#MISE description="Build the Node addon for one npm platform into target/npm-native/rlmesh.{platform}-{arch}.node (Linux and Windows cross-build from Linux; Darwin needs macOS)"
#MISE dir="{{ config_root }}"
#USAGE arg "<platform>" help="npm platform: linux-x64, linux-arm64, win32-x64, darwin-x64 or darwin-arm64"

# Each platform becomes one @rlmesh/{platform}-{arch} package (release:js:package).
# Linux links against glibc 2.28 through cargo-zigbuild, the floor of Node 22's
# own Linux builds. Windows uses cargo-xwin, like the C/C++ package.
set -euo pipefail
platform="${usage_platform:?usage: release:js:native <platform>}"

case "$platform" in
  linux-x64)    triple=x86_64-unknown-linux-gnu  build=(cargo zigbuild --target x86_64-unknown-linux-gnu.2.28) lib=librlmesh_node.so ;;
  linux-arm64)  triple=aarch64-unknown-linux-gnu build=(cargo zigbuild --target aarch64-unknown-linux-gnu.2.28) lib=librlmesh_node.so ;;
  win32-x64)    triple=x86_64-pc-windows-msvc    build=(cargo xwin build --target x86_64-pc-windows-msvc) lib=rlmesh_node.dll ;;
  darwin-x64)   triple=x86_64-apple-darwin       build=(cargo build --target x86_64-apple-darwin) lib=librlmesh_node.dylib ;;
  darwin-arm64) triple=aarch64-apple-darwin      build=(cargo build --target aarch64-apple-darwin) lib=librlmesh_node.dylib ;;
  *) echo "error: unknown npm platform '$platform'" >&2; exit 1 ;;
esac
if [[ "$platform" == darwin-* && "$(uname -s)" != Darwin ]]; then
  echo "error: $platform needs a macOS host" >&2
  exit 1
fi

rustup target add "$triple"
export XWIN_ACCEPT_LICENSE=1 ZIG_GLOBAL_CACHE_DIR="$PWD/target/zig-cache"
# Node for Windows does not ship the MSVC runtime, so the addon links it statically.
export CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_RUSTFLAGS="-C target-feature=+crt-static"
"${build[@]}" --profile node -p rlmesh-node

target_dir="$(cargo metadata --format-version 1 --no-deps | python3 -c 'import json, sys; print(json.load(sys.stdin)["target_directory"])')"
out="target/npm-native/rlmesh.$platform.node"
mkdir -p target/npm-native
cp "$target_dir/$triple/node/$lib" "$out"
echo "$out $(wc -c <"$out" | tr -d ' ') bytes"
