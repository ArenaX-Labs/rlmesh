#!/usr/bin/env bash
#MISE description="Type-check the Windows wheel's and Node addon's crates for x86_64-pc-windows-msvc with cargo-xwin, the cross toolchain their release builds use"
#MISE dir="{{ config_root }}"

# The Windows wheel and Node addon are cross-built from Linux at release time
# only (build:python:wheel windows: maturin, which drives cargo-xwin;
# release:js:native win32-x64: cargo-xwin). This checks the same crates and
# features on pull requests that reach them, so code that only compiles on unix
# fails there, not at release. It runs build scripts, so C dependencies compile
# with clang-cl and archive with llvm-lib, from the same tools as the release
# builds (scripts/xwin-env.sh): clang must be on PATH. Linking, and the addon's
# static CRT, are left to the release builds. The first run downloads the MSVC
# CRT/SDK into ~/.cache/cargo-xwin.
set -euo pipefail

. scripts/xwin-env.sh

# The wheel's crate and features as python/rlmesh/pyproject.toml gives them to
# maturin ([tool.maturin] no-default-features, features).
cargo xwin check --locked --target "$xwin_triple" \
  -p rlmesh-python --no-default-features --features cli,abi3-py311
# The addon's crate as release:js:native builds it (default features).
cargo xwin check --locked --target "$xwin_triple" -p rlmesh-node
