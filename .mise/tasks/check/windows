#!/usr/bin/env bash
#MISE description="Type-check the Windows wheel's and Node addon's crates for x86_64-pc-windows-msvc with cargo-xwin, the cross toolchain their release builds use"
#MISE dir="{{ config_root }}"

set -euo pipefail

. scripts/xwin-env.sh

cargo xwin check --locked --target "$xwin_triple" \
  -p rlmesh-python --no-default-features --features cli,abi3-py311
cargo xwin check --locked --target "$xwin_triple" -p rlmesh-node
