#!/usr/bin/env bash
#MISE description="Fetch zenoh-pico, the boards' network, at the version of the host's zenoh, into target/zenoh-pico (once), and print its path. build:esp32 and test:esp32:host use it"
#MISE dir="{{ config_root }}"
set -euo pipefail

# The host's zenoh is pinned in Cargo.toml; zenoh-pico follows its version.
version=1.10.1
src="${CARGO_TARGET_DIR:-target}/zenoh-pico/src-$version"
if [ ! -d "$src" ]; then
  git clone -q -c advice.detachedHead=false --depth 1 --branch "$version" \
    https://github.com/eclipse-zenoh/zenoh-pico.git "$src" >&2
fi
echo "$src"
