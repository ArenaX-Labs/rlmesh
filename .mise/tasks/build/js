#!/usr/bin/env bash
#MISE description="Build javascript/rlmesh/wasm (rlmesh-wasm) for the browser (cargo --profile wasm, wasm-bindgen --target web, wasm-opt -Oz) and bundle javascript/rlmesh (dist/, .d.ts)"
#MISE dir="{{ config_root }}"
#MISE depends=["setup:js"]
#USAGE flag "--demo" help="Also bundle the browser example (examples/web) into examples/web/dist"

# Output: javascript/rlmesh/pkg (wasm-bindgen glue and the optimized .wasm,
# ignored) and javascript/rlmesh/dist (the package). Sizes go to pkg/size.json.
set -euo pipefail
PATH="$(mise -C javascript bin-paths | paste -sd: -):$PATH"

pkg=javascript/rlmesh/pkg
target_dir="$(cargo metadata --format-version 1 --no-deps | python3 -c 'import json, sys; print(json.load(sys.stdin)["target_directory"])')"
cargo build -p rlmesh-wasm --target wasm32-unknown-unknown --profile wasm
rm -rf "$pkg" && mkdir -p "$pkg"
wasm-bindgen "$target_dir/wasm32-unknown-unknown/wasm/rlmesh_wasm.wasm" --out-dir "$pkg" --out-name rlmesh --target web
# Rust 1.99 emits these post-MVP features; wasm-opt rejects the module without the flags.
wasm-opt -Oz --enable-bulk-memory --enable-nontrapping-float-to-int --enable-sign-ext --enable-mutable-globals \
  "$pkg/rlmesh_bg.wasm" -o "$pkg/rlmesh_bg.opt.wasm"
mv "$pkg/rlmesh_bg.opt.wasm" "$pkg/rlmesh_bg.wasm"
size() { wc -c <"$1" | tr -d ' '; }
printf '{"wasm":%s,"wasm_gzip9":%s,"glue_js":%s}\n' \
  "$(size "$pkg/rlmesh_bg.wasm")" "$(gzip -9 -c "$pkg/rlmesh_bg.wasm" | wc -c | tr -d ' ')" "$(size "$pkg/rlmesh.js")" | tee "$pkg/size.json"

cd javascript/rlmesh
node build.mjs ${usage_demo:+--demo}
