#!/usr/bin/env bash
#MISE description="Flash integrations/arduino's Eyes example to a plugged-in board and check it against the board's half of the tether spec (crates/rlmesh-tether/examples/board_check.rs). Local only: needs the board, arduino-cli with its core, and the Servo library"
#MISE dir="{{ config_root }}"
#USAGE arg "[port]" default="/dev/ttyACM0" help="The board's serial port"
#USAGE flag "--fqbn <fqbn>" default="arduino:renesas_uno:minima" help="The board (arduino-cli board listall): arduino:avr:nano, arduino:avr:uno, arduino:renesas_uno:minima, ..."
#USAGE flag "--no-upload" help="Check the sketch already on the board"
#USAGE flag "--clear-estop" help="Clear the stored e-stop latch on attach (with the button released)"
# ARDUINO_CLI names an arduino-cli binary off PATH.
set -euo pipefail

port="${usage_port:-/dev/ttyACM0}"
fqbn="${usage_fqbn:-arduino:renesas_uno:minima}"
cli="${ARDUINO_CLI:-arduino-cli}"
lib=integrations/arduino

if [ ! -r "$port" ] || [ ! -w "$port" ]; then
  echo "can't open $port: is the board plugged in, and are you in its group ($(stat -c %G "$port" 2>/dev/null || echo dialout))?" >&2
  exit 1
fi
cargo build -q -p rlmesh-tether --example board_check
if [ "${usage_no_upload:-false}" != true ]; then
  echo "==> arduino-cli: examples/Eyes to $fqbn on $port"
  "$cli" compile --fqbn "$fqbn" --library "$lib" --build-path target/tether-board \
    --upload --port "$port" "$lib/examples/Eyes"
  # A native-USB board re-enumerates after the upload.
  for _ in $(seq 50); do [ -e "$port" ] && break; sleep 0.1; done
  sleep 1
fi
cargo run -q -p rlmesh-tether --example board_check -- "$port" ${usage_clear_estop:+--clear-estop}
