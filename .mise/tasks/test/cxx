#!/usr/bin/env bash
#MISE description="Compile the C/C++ ABI, build C and C++ env/model smokes, check native runtime declarations and legacy defaults, and run model/env gRPC flows"
#MISE dir="{{ config_root }}"

# The C/C++ analogue of the Python build+typecheck+test gates: the cdylib + the
# hand-authored header + the wrapper are otherwise compiled by nothing. zig builds
# the library; the consumer surface is validated with whatever $CC/$CXX point at —
# clang/gcc in CI, zig's bundled clang as the zero-setup local default.
set -euo pipefail

repo_root="$PWD"
inc="$repo_root/crates/rlmesh-capi/include"
target="target/debug"

# Compiler is overridable so CI can run this same task under real clang/gcc (and,
# later, MSVC); $CC/$CXX may carry args ("zig cc"), so they are left unquoted below.
CC="${CC:-zig cc}"
CXX="${CXX:-zig c++}"
echo "==> CC='$CC'  CXX='$CXX'"

warn=(-Wall -Wextra -Werror)
# zig-only quirks: its cc wrapper injects an unused -c, and its bundled libc++
# headers emit -Wnullability-completeness noise on <variant> etc. Suppress those
# only for zig, so real clang/gcc keep full -Werror coverage of the consumer surface.
cc_quiet=()
cxx_quiet=()
case "$CC" in *zig*) cc_quiet=(-Wno-unused-command-line-argument) ;; esac
case "$CXX" in *zig*) cxx_quiet=(-Wno-unused-command-line-argument -Wno-nullability-completeness) ;; esac

# zig 0.16's `cc -fsyntax-only` is broken (errors "FileNotFound"), so the header
# typecheck compiles to a throwaway object in this scratch dir instead.
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# 1. Build the cdylib (the consumer links it) + the end-to-end harness.
cargo build -p rlmesh-capi --lib --bin e2e_harness --bin e2e_env_harness

# 2. Typecheck the public surface in BOTH languages (the basedpyright analogue):
#    a compile catches C-vs-C++ / extern "C" divergence in the header.
echo "==> header compiles as C11 and as C++17"
printf '#include <rlmesh.h>\n' |
  $CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" -c -x c - -o "$tmp/header_c.o"
printf '#include <rlmesh.hpp>\n' |
  $CXX -std=c++17 "${warn[@]}" "${cxx_quiet[@]}" -I "$inc" -c -x c++ - -o "$tmp/header_cxx.o"
echo "==> C header stays warning-free in C++98"
printf '#include <rlmesh.h>\n' |
  $CXX -std=c++98 "${warn[@]}" -pedantic "${cxx_quiet[@]}" -I "$inc" -c -x c++ - -o "$tmp/header_cxx98.o"
# The wrapper is header-only templates: including it instantiates almost nothing.
# cpp_surface.cpp names every public type and member, so a template that stops
# compiling fails here instead of in a downstream build. Compiled, never linked.
echo "==> C++ wrapper surface instantiates"
$CXX -std=c++17 "${warn[@]}" "${cxx_quiet[@]}" -I "$inc" \
  -c crates/rlmesh-capi/examples/cpp_surface.cpp -o "$tmp/cpp_surface.o"

# 3. Compile + link the C and C++ smokes against the cdylib (the build + link gate:
#    a missing / renamed / wrong-signature export fails right here).
echo "==> build the C and C++ model and env smokes"
link=(-L "$target" -lrlmesh_capi -Wl,-rpath,"$repo_root/$target" -lpthread -ldl -lm)
$CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/c_model.c "${link[@]}" -o "$target/c_model_smoke"
$CXX -std=c++17 "${warn[@]}" "${cxx_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/cpp_model.cpp "${link[@]}" -o "$target/cpp_model_smoke"
$CXX -std=c++17 "${warn[@]}" "${cxx_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/cpp_env.cpp "${link[@]}" -o "$target/cpp_env_smoke"
$CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/c_env.c "${link[@]}" -o "$target/c_env_smoke"

# Assert runtime comes from the host translation unit, including after changing
# the language standard. Each run goes through the real ABI describe export.
for standard in 11 17; do
  $CC -std=c$standard "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
    crates/rlmesh-capi/examples/c_env.c "${link[@]}" -o "$tmp/c_env_$standard"
  "$tmp/c_env_$standard" | python scripts/check-native-runtime.py c "$standard"
done
for standard in 17 20; do
  $CXX -std=c++$standard "${warn[@]}" "${cxx_quiet[@]}" -I "$inc" \
    crates/rlmesh-capi/examples/cpp_env.cpp "${link[@]}" -o "$tmp/cpp_env_$standard"
  "$tmp/cpp_env_$standard" --describe | python scripts/check-native-runtime.py c++ "$standard"
done

echo "==> C spaces API: build, seed, sample, contains, typed bounds, error classes"
$CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/c_spaces.c "${link[@]}" -o "$tmp/c_spaces"
"$tmp/c_spaces"

echo "==> C config helper detects a C++17 translation unit"
$CXX -std=c++17 "${warn[@]}" "${cxx_quiet[@]}" -I "$inc" -x c++ \
  crates/rlmesh-capi/examples/c_env.c "${link[@]}" -o "$tmp/c_header_cpp"
"$tmp/c_header_cpp" | python scripts/check-native-runtime.py c++ 17

echo "==> legacy C++ empty declaration equals the old C ABI output byte-for-byte"
$CXX -std=c++17 "${warn[@]}" "${cxx_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/cpp_runtime.cpp "${link[@]}" -o "$tmp/cpp_runtime"
"$tmp/cpp_runtime"

echo "==> C++ exception classes follow the Python inheritance; the header builds without exceptions"
$CXX -std=c++17 "${warn[@]}" "${cxx_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/cpp_errors.cpp "${link[@]}" -o "$tmp/cpp_errors"
"$tmp/cpp_errors"
printf '#include <rlmesh.hpp>\n' |
  $CXX -std=c++17 -fno-exceptions "${warn[@]}" "${cxx_quiet[@]}" -I "$inc" -c -x c++ - -o "$tmp/header_noexcept.o"

# 4. Run each smoke against a live env over real gRPC (the pytest analogue).
#    Both print the same run report; assert the real numbers, not just exit 0.
#    The harness env takes two steps per episode, and the harness also checks
#    each smoke printed the second predict's derived seed per episode (the
#    RLMeshEpisode layout gate: predict_index / predict_seed crossed the ABI).
echo "==> C model end-to-end vs a live env"
"$target/e2e_harness" "$target/c_model_smoke" "run report: episodes=3 steps=6"
echo "==> C++ model end-to-end vs a live env"
"$target/e2e_harness" "$target/cpp_model_smoke" "run report: episodes=3 steps=6"

# 5. The env side, inverted: the C++ env serves, a model drives it, and closing
#    its stdin must drain it, run its close hook and exit 0.
echo "==> C++ env end-to-end vs a live model"
"$target/e2e_env_harness" "$target/cpp_env_smoke"
echo "==> test:cxx OK"
