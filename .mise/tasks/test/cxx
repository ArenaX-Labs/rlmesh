#!/usr/bin/env bash
#MISE description="Compile the C/C++ ABI, build C and C++ env/model smokes, check native runtime declarations and C++17/C++20 parity, and run model/env gRPC flows"
#MISE dir="{{ config_root }}"

# The C/C++ analogue of the Python build+typecheck+test gates: the cdylib + the
# hand-authored header + the wrapper are otherwise compiled by nothing. zig builds
# the library; the consumer surface is validated with whatever $CC/$CXX point at —
# clang/gcc in CI, zig's bundled clang as the zero-setup local default.
set -euo pipefail

repo_root="$PWD"
inc="$repo_root/crates/rlmesh-capi/include"
target="target/debug"

# Compiler is overridable so CI can run this same task under real clang/gcc (and,
# later, MSVC); $CC/$CXX may carry args ("zig cc"), so they are left unquoted below.
CC="${CC:-zig cc}"
# An explicit CXX selects one compiler (as in CI). The local default exercises
# both Clang (zig's bundled compiler) and GCC when it is available.
compilers=("${CXX:-zig c++}")
if [ -z "${CXX:-}" ] && command -v g++ >/dev/null; then compilers+=(g++); fi
CXX="${compilers[0]}"
echo "==> CC='$CC'  CXX='$CXX'"

warn=(-Wall -Wextra -Werror)
# zig-only quirks: its cc wrapper injects an unused -c, and its bundled libc++
# headers emit -Wnullability-completeness noise on <variant> etc. Suppress those
# only for zig, so real clang/gcc keep full -Werror coverage of the consumer surface.
cc_quiet=()
cxx_quiet=()
case "$CC" in *zig*) cc_quiet=(-Wno-unused-command-line-argument) ;; esac
case "$CXX" in *zig*) cxx_quiet=(-Wno-unused-command-line-argument -Wno-nullability-completeness) ;; esac

# zig 0.16's `cc -fsyntax-only` is broken (errors "FileNotFound"), so the header
# typecheck compiles to a throwaway object in this scratch dir instead.
# Keep compiler scratch off the shared /tmp filesystem, including subprocesses.
export TMPDIR="${TMPDIR:-$repo_root/target/cxx-tmp}"
mkdir -p "$TMPDIR"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# 1. Build the cdylib (the consumer links it) + the end-to-end harness.
cargo build -p rlmesh-capi --lib --bin e2e_harness --bin e2e_env_harness

# 2. Typecheck the public surface in BOTH languages (the basedpyright analogue):
#    a compile catches C-vs-C++ / extern "C" divergence in the header.
echo "==> header compiles as C11; C++ standards are checked below"
printf '#include <rlmesh.h>\n' |
  $CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" -c -x c - -o "$tmp/header_c.o"
echo "==> C header stays warning-free in C++98"
printf '#include <rlmesh.h>\n' |
  $CXX -std=c++98 "${warn[@]}" -pedantic "${cxx_quiet[@]}" -I "$inc" -c -x c++ - -o "$tmp/header_cxx98.o"
echo "==> vendored DLPack v1.0 is verbatim and accepts either include order"
python - "$inc/rlmesh.h" "$tmp/dlpack.h" <<'PY'
import hashlib
import pathlib
import sys

header = pathlib.Path(sys.argv[1]).read_text()
start = header.index("/*!\n *  Copyright (c) 2017 by Contributors")
end_marker = "#endif  // DLPACK_DLPACK_H_\n"
end = header.index(end_marker, start) + len(end_marker)
upstream = header[start:end].encode()
assert hashlib.sha256(upstream).hexdigest() == (
    "99996dc5c822604961efa190a033f146bfcb8d81d664005a402e0d976b56f600"
), "vendored DLPack must match upstream dmlc/dlpack v1.0 verbatim"
pathlib.Path(sys.argv[2]).write_bytes(upstream)
PY
for first in dlpack.h rlmesh.h; do
  second=rlmesh.h
  if [ "$first" = rlmesh.h ]; then second=dlpack.h; fi
  printf '#include <%s>\n#include <%s>\n' "$first" "$second" |
    $CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" -I "$tmp" -c -x c - \
      -o "$tmp/dlpack_order_c.o"
  printf '#include <%s>\n#include <%s>\n' "$first" "$second" |
    $CXX -std=c++17 "${warn[@]}" "${cxx_quiet[@]}" -I "$inc" -I "$tmp" -c -x c++ - \
      -o "$tmp/dlpack_order_cxx.o"
done
if printf '#define DLPACK_DLPACK_H_\n#include <rlmesh.h>\n' |
  $CC -std=c11 "${cc_quiet[@]}" -I "$inc" -c -x c - -o "$tmp/old_dlpack.o" \
    >"$tmp/old_dlpack.log" 2>&1; then
  echo "ERROR: a pre-1.0 DLPack header was accepted" >&2
  exit 1
fi
grep -qE 'RLMesh requires DLPack 1.0 or newer' "$tmp/old_dlpack.log"
# Compile-only layout assertions cover both 32-bit double-alignment conventions.
# Other compilers still check their native layout when c_adapters runs below.
case "$CC" in *zig*)
  echo "==> C adapter layouts compile for 32-bit x86 and ARM"
  $CC -target x86-linux-musl -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
    -c crates/rlmesh-capi/examples/c_adapters.c -o "$tmp/layout_x86.o"
  $CC -target arm-linux-musleabihf -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
    -c crates/rlmesh-capi/examples/c_adapters.c -o "$tmp/layout_arm.o"
  for triple in x86-linux-musl arm-linux-musleabihf; do
    $CC -target "$triple" -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
      -c crates/rlmesh-capi/examples/c_dlpack.c -o "$tmp/dlpack_$triple.o"
    $CC -target "$triple" -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
      -c crates/rlmesh-capi/examples/c_recorder.c -o "$tmp/recorder_$triple.o"
  done
;; esac

# Compile and run C gates once; the C++ consumers below share the same library.
link=(-L "$target" -lrlmesh_capi -Wl,-rpath,"$repo_root/$target" -lpthread -ldl -lm)
# The shared behavioural fixtures use the same toolchain, ABI library and warnings.
mkdir -p "$tmp/parity"
$CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
  tests/parity/c_runner.c "${link[@]}" -o "$tmp/parity/c"
for example in c_model c_env; do
  $CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
    "crates/rlmesh-capi/examples/$example.c" "${link[@]}" -o "$target/${example}_smoke"
done
for standard in 11 17; do
  $CC -std=c$standard "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
    crates/rlmesh-capi/examples/c_env.c "${link[@]}" -o "$tmp/c_env_$standard"
  "$tmp/c_env_$standard" | python scripts/check-native-runtime.py c "$standard"
done
echo "==> C ABI 5 minima, unknown tails and out-struct boundaries"
$CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/c_abi5.c "${link[@]}" -o "$tmp/c_abi5"
"$tmp/c_abi5"
echo "==> C spaces API: build, seed, sample, contains, typed bounds, error classes"
$CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/c_spaces.c "${link[@]}" -o "$tmp/c_spaces"
"$tmp/c_spaces"
echo "==> C DLPack import/export ownership, source lifetimes and sized options"
$CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/c_dlpack.c "${link[@]}" -o "$tmp/c_dlpack"
"$tmp/c_dlpack"
echo "==> C ABI 5 env authoring, server lifecycle and sized inputs"
$CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/c_env_api.c "${link[@]}" -o "$tmp/c_env_api"
"$tmp/c_env_api"
echo "==> C ABI 5 factories, discriminants, variants and cancellation"
$CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/c_factory.c "${link[@]}" -o "$tmp/c_factory"
"$tmp/c_factory"
echo "==> C ABI 5 typed adapters, transforms, ownership and model integration"
$CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/c_adapters.c "${link[@]}" -o "$target/c_adapters_smoke"
"$target/c_adapters_smoke"
echo "==> C ABI 5 Model load, declarations, cloning and lifecycle"
$CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/c_policy.c "${link[@]}" -o "$tmp/c_policy"
"$tmp/c_policy"
echo "==> C ABI 5 run targets, hooks, contexts, budgets and results"
$CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/c_run.c "${link[@]}" -o "$tmp/c_run"
"$tmp/c_run"
echo "==> C ABI 5 adapter readers, instructions, contexts and frame-source lifetimes"
$CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/c_reads.c "${link[@]}" -o "$tmp/c_reads"
"$tmp/c_reads"
echo "==> C View/Recorder parsing, snapshots, capture ownership, AV1 and bundle export"
$CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/c_recorder.c "${link[@]}" -o "$tmp/c_recorder"
"$tmp/c_recorder" "$tmp"
echo "==> C ABI 5 remote clients, session borrows and vector buffer checks"
$CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/c_remote.c "${link[@]}" -o "$tmp/c_remote"
"$tmp/c_remote"
echo "==> C ABI 5 Describe types, instances, branches and server snapshots"
$CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/c_describe.c "${link[@]}" -o "$tmp/c_describe"
"$tmp/c_describe"
echo "==> C core: build info, editions, constants, warning handler"
$CC -std=c11 "${warn[@]}" "${cc_quiet[@]}" -I "$inc" \
  crates/rlmesh-capi/examples/c_core.c "${link[@]}" -o "$tmp/c_core"
"$tmp/c_core"

echo "==> C model end-to-end vs a live env"
"$target/e2e_harness" "$target/c_model_smoke" "run report: episodes=3 steps=6"

for compiler in "${compilers[@]}"; do
  compiler_quiet=()
  case "$compiler" in *zig*) compiler_quiet=(-Wno-unused-command-line-argument -Wno-nullability-completeness) ;; esac
  for standard in 17 20; do
    echo "==> C++$standard fixtures ($compiler)"
    flags=(-std=c++$standard "${warn[@]}" -pedantic-errors "${compiler_quiet[@]}" -I "$inc")
    printf '#include <rlmesh.hpp>\n' |
      $compiler "${flags[@]}" -c -x c++ - -o "$tmp/header_cxx.o"
    # Parse and instantiate authoring templates under hostile host macros.
    $compiler "${flags[@]}" -Wshadow -Wconversion -Wsign-conversion -fno-rtti \
      -c crates/rlmesh-capi/examples/cpp_hostile.cpp -o "$tmp/cpp_hostile.o"
    lifetime_flags=()
    # Ask the compiler what it is: a name pattern like *g++* also matches clang++.
    macros=$($compiler -dM -E -x c++ /dev/null 2>/dev/null)
    [[ $macros == *__clang__* ]] || lifetime_flags=(-Wdangling-reference)
    $compiler "${flags[@]}" -Wshadow -Wconversion -Wsign-conversion "${lifetime_flags[@]}" \
      -c crates/rlmesh-capi/examples/cpp_review.cpp -o "$tmp/cpp_review.o"
    $compiler "${flags[@]}" -c crates/rlmesh-capi/examples/cpp_surface.cpp -o "$tmp/cpp_surface.o"
    $compiler "${flags[@]}" -c crates/rlmesh-capi/examples/cpp_options.cpp -o "$tmp/cpp_options.o"
    $compiler "${flags[@]}" -c examples/chrono/src/scripted_model.cpp -o "$tmp/chrono_scripted_model.o"
    for example in cpp_core cpp_errors cpp_runtime cpp_spaces cpp_parity cpp_box_cleanup cpp_constants cpp_span cpp_review; do
      $compiler "${flags[@]}" "crates/rlmesh-capi/examples/$example.cpp" "${link[@]}" -o "$tmp/$example"
      "$tmp/$example"
    done
    $compiler "${flags[@]}" tests/parity/cpp_runner.cpp "${link[@]}" -o "$tmp/parity/cpp"
    RLMESH_PARITY_BIN="$tmp/parity" python tests/parity/run.py --native-only --no-build
    # Exception payloads must be destroyed by the shared library that created them.
    $compiler "${flags[@]}" -fPIC -shared crates/rlmesh-capi/examples/cpp_payload_plugin.cpp \
      "${link[@]}" -o "$tmp/libcpp_payload_plugin.so"
    $compiler "${flags[@]}" crates/rlmesh-capi/examples/cpp_payload.cpp \
      "$tmp/libcpp_payload_plugin.so" "${link[@]}" -o "$tmp/cpp_payload"
    "$tmp/cpp_payload"
    # The Unreal plugin's game-thread env, which needs no Unreal headers.
    $compiler "${flags[@]}" -Wshadow -Wconversion -Wsign-conversion -fno-rtti \
      -I integrations/unreal/RLMesh/Source/RLMeshUnreal/Public \
      integrations/unreal/RLMesh/Tests/game_thread_env_test.cpp "${link[@]}" -o "$tmp/unreal_game_thread_env"
    "$tmp/unreal_game_thread_env"
    for example in cpp_model cpp_env; do
      $compiler "${flags[@]}" "crates/rlmesh-capi/examples/$example.cpp" \
        "${link[@]}" -o "$tmp/$example"
    done
    "$tmp/cpp_env" --describe | python scripts/check-native-runtime.py c++ "$standard"
    $compiler "${flags[@]}" -x c++ crates/rlmesh-capi/examples/c_env.c \
      "${link[@]}" -o "$tmp/c_header_cpp"
    "$tmp/c_header_cpp" | python scripts/check-native-runtime.py c++ "$standard"
    "$target/e2e_harness" "$tmp/cpp_model" "run report: episodes=3 steps=6"
    "$target/e2e_env_harness" "$tmp/cpp_env"
    if [ "$standard" = 20 ]; then
      $compiler "${flags[@]}" crates/rlmesh-capi/examples/cpp_designated.cpp \
        "${link[@]}" -o "$tmp/cpp_designated"
      "$tmp/cpp_designated"
    fi
    # Exceptions remain required under both standards.
    if printf '#include <rlmesh.hpp>\n' |
      $compiler -std=c++$standard -fno-exceptions -I "$inc" -c -x c++ - \
        -o "$tmp/noexceptions.o" >"$tmp/noexceptions.log" 2>&1; then
      echo "ERROR: wrapper accepted disabled exceptions" >&2; exit 1
    fi
    grep -qE 'rlmesh.hpp requires exceptions' "$tmp/noexceptions.log"
  done
  echo "==> C++17/C++20 header tokens are identical ($compiler)"
  for standard in 17 20; do
    printf '#include <rlmesh.hpp>\n' |
      $compiler -std=c++$standard "${compiler_quiet[@]}" -I "$inc" -E -x c++ - \
        -o "$tmp/shape$standard.ii"
  done
  python crates/rlmesh-capi/examples/cpp_shape.py "$inc/rlmesh.hpp" \
    "$tmp/shape17.ii" "$tmp/shape20.ii"
  # The token comparison above is the one-shape check. No LTO -Wodr here: older
  # libstdc++ (GCC 13) defines std::optional and std::variant differently per
  # standard, so it reports every wrapper type that holds one.
  echo "==> C++17 and C++20 translation units share wrapper types ($compiler)"
  $compiler -std=c++17 "${warn[@]}" "${compiler_quiet[@]}" -I "$inc" \
    -c crates/rlmesh-capi/examples/cpp_mixed17.cpp -o "$tmp/cpp_mixed17.o"
  $compiler -std=c++20 "${warn[@]}" "${compiler_quiet[@]}" -I "$inc" \
    -c crates/rlmesh-capi/examples/cpp_mixed20.cpp -o "$tmp/cpp_mixed20.o"
  $compiler "${warn[@]}" "$tmp/cpp_mixed17.o" "$tmp/cpp_mixed20.o" "${link[@]}" -o "$tmp/cpp_mixed"
  "$tmp/cpp_mixed"
  if printf '#include <rlmesh.hpp>\n' |
    $compiler -std=c++14 -I "$inc" -c -x c++ - -o "$tmp/oldstandard.o" >"$tmp/oldstandard.log" 2>&1; then
    echo "ERROR: wrapper accepted C++14" >&2; exit 1
  fi
  grep -qE 'rlmesh.hpp requires C\+\+17' "$tmp/oldstandard.log"
done
echo "==> test:cxx OK"
