#!/usr/bin/env bash
#MISE description="Run the ESP32 library's transport (integrations/esp32/src/rlmesh_zenoh.c, over zenoh-pico) and the device robot on Linux against a real session host (rlmesh host): the board's loop with Linux's clock and randomness"
#MISE dir="{{ config_root }}"
# Local only: it fetches and builds zenoh-pico.
set -euo pipefail

target_dir="${CARGO_TARGET_DIR:-target}"
out="$target_dir/esp32-host"
zp_src="$(.mise/tasks/build/zenoh-pico)"
zp_build="$target_dir/zenoh-pico/linux"
mkdir -p "$out"

if [ ! -f "$zp_build/lib/libzenohpico.a" ]; then
  echo "==> zenoh-pico for Linux"
  cmake -S "$zp_src" -B "$zp_build" -DCMAKE_BUILD_TYPE=Release -DBUILD_EXAMPLES=OFF \
    -DBUILD_TESTING=OFF -DBUILD_SHARED_LIBS=OFF >"$out/zenoh-pico.log" 2>&1 &&
    cmake --build "$zp_build" --target zenohpico_static -j 4 >>"$out/zenoh-pico.log" 2>&1 ||
    { cat "$out/zenoh-pico.log" >&2; exit 1; }
fi
echo "==> rlmesh-device and rlmesh host"
cargo build -q -p rlmesh-device -p rlmesh-cli
echo "==> the board's loop"
# The header the library compiles against, staged as build:esp32 does.
cp crates/rlmesh-device/include/rlmesh_device.h integrations/esp32/src/
cc -std=gnu11 -O1 -g -Wall -Wextra -Werror -DZENOH_LINUX -DZENOH_C_STANDARD=11 \
  -I"$zp_build/include" -I"$zp_src/include" -Iintegrations/esp32/src \
  integrations/esp32/test/host_robot.c integrations/esp32/src/rlmesh_zenoh.c \
  "$target_dir/debug/librlmesh_device.a" "$zp_build/lib/libzenohpico.a" -lpthread -ldl -lm \
  -o "$out/host_robot"

log="$out/host.log"
"$target_dir/debug/rlmesh" host --listen 127.0.0.1:0 >"$log" 2>&1 &
host=$!
trap 'kill "$host" 2>/dev/null || true' EXIT
for _ in $(seq 100); do
  [ -s "$log" ] && break
  sleep 0.1
done
address="$(head -1 "$log")"
case "$address" in
  *#*) ;;
  *) echo "rlmesh host printed no address:" >&2; cat "$log" >&2; exit 1 ;;
esac
"$out/host_robot" "$address" 15
