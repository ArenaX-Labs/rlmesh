# Formatting for the rlmesh-capi C ABI header, C++ wrapper, and examples.
# Google base (2-space, left-pointer) with a 100-column limit to match the repo's
# Rust/Python line width. The formatter owns the style — like rustfmt / ruff.
BasedOnStyle: Google
ColumnLimit: 100
IndentWidth: 2
DerivePointerAlignment: false
PointerAlignment: Left
